root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml,xml,uxml,uss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{asset,unity,prefab,mat,anim,controller,meta}]
# Unity YAML — leave it alone
trim_trailing_whitespace = false
insert_final_newline = false
