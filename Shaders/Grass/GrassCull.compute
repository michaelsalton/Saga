#pragma kernel CullBlades

// shares the struct with the vertex shader so the layouts can't drift apart
#include "Packages/com.saltbox.saga/Shaders/Grass/GrassBladeData.hlsl"

AppendStructuredBuffer<uint> _VisibleBladeIndicesOut;
float4 _FrustumPlanes[6];
uint _BladeCount;

[numthreads(64, 1, 1)]
void CullBlades(uint3 threadID : SV_DispatchThreadID)
{
    uint bladeIndex = threadID.x;
    // the last group overhangs the buffer when the count isn't a multiple of 64
    if (bladeIndex >= _BladeCount) return;

    GrassBlade blade = _Blades[bladeIndex];
    // wind swings the tip on an arc of this radius around the root, in any direction including straight up
    float reach = blade.height * sqrt(1.0 + blade.bend * blade.bend);
    // root, control point and tip all stay within reach of the root, so the whole curve does (convex hull)
    float3 center = blade.rootPositionWS;
    float radius = reach + blade.width;

    for (int i = 0; i < 6; i++)
    {
        float4 plane = _FrustumPlanes[i];
        // plane normals point inward, so a distance below -radius means the sphere is fully outside
        if (dot(plane.xyz, center) + plane.w < -radius) return;
    }
    _VisibleBladeIndicesOut.Append(bladeIndex);
}
