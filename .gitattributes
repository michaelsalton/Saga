# Auto-normalize line endings on commit (LF in repo, native in workdir)
* text=auto eol=lf

# Unity text-based assets — force LF, mark as text so diffs work
*.cs            text diff=csharp
*.shader        text
*.cginc         text
*.hlsl          text
*.compute       text
*.uss           text
*.uxml          text
*.json          text
*.xml           text
*.yaml          text
*.yml           text
*.md            text
*.txt           text
*.asmdef        text
*.asmref        text
*.inputactions  text

# Unity YAML assets — treat as text but disable diffs (they're huge and noisy)
